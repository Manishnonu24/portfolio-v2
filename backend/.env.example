# ── OpenAI ────────────────────────────────────────────────────────────────────
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ── MySQL Database ────────────────────────────────────────────────────────────
# Format: mysql+pymysql://user:password@host:port/dbname
# Run seed.py first to create the demo database: python seed.py
DATABASE_URL=mysql+pymysql://root:@localhost:3306/sql_chatbot_db

# ── MySQL Connection Details (used by seed.py) ────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sql_chatbot_db
